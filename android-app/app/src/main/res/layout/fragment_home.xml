<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- DJI App Connection Status -->

        <LinearLayout
            android:id="@+id/layout_dji_app_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/header_dji_app_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DJI App Connection Status" />

                <Button
                    android:id="@+id/btn_connect_app_retry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Retry Connect" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/updatable_dji_app_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you're seeing this something is wrong" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_drone_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/header_dji_drone_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Drone Connection Status" />

                <Button
                    android:id="@+id/btn_connect_drone_retry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Retry Connect" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/updatable_dji_drone_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you're seeing this something is wrong" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_liftoff_landing_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/header_liftoff_landing_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Drone Liftoff/Landing" />

                <Button
                    android:id="@+id/btn_liftoff_landing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activate Liftoff" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/updatable_liftoff_landing_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you're seeing this something is wrong" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_virtual_stickmode_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/header_virtual_stickmode_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Virtual Stick Override" />

                <Button
                    android:id="@+id/btn_change_virtual_stickmode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Virtual Stick" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/home_layout_borders"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/updatable_virtual_stickmode_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If you're seeing this something is wrong" />

            </LinearLayout>
        </LinearLayout>

        <!-- Drone Connection Status -->

    </LinearLayout>


</FrameLayout>