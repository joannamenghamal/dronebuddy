DRONE_PLATFORM=mock
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Laptop camera for --drone mock (try 1 if 0 is the wrong camera)
CAMERA_INDEX=0

# Fractions of each platform's own max speed (0.0-1.0). Kept low by default
# since this drives an autonomous system - raise only after ground-testing
# with `--drone mock`.
MAX_FORWARD_SPEED=0.3
MAX_LATERAL_SPEED=0.3
MAX_VERTICAL_SPEED=0.2
MAX_YAW_RATE=0.3

TARGET_DISTANCE=450

MIN_BATTERY_PERCENT=20
STALE_COMMAND_TIMEOUT_S=1.0
CONNECTION_LOSS_TIMEOUT_S=3.0
LOST_PERSON_TIMEOUT_S=2.0
