<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      READ/WRITE_EXTERNAL_STORAGE are listed in DJI's own MSDK V5 tutorial
      as of the revision checked in this session (see DJI_MINI_3_SETUP.md).
      On modern targetSdk levels these are largely superseded by scoped
      storage - keep only if the specific SDK calls this app ends up using
      actually require them; UNVERIFIED whether 5.18.0 still does.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.usb.accessory" android:required="true" />

    <!--
      DRONE_BRIDGE.md's wire protocol is plain ws://, not wss:// - the DJI
      aircraft AAR's own manifest declares usesCleartextTraffic=false, which
      would otherwise win the manifest merge and silently break the bridge
      socket. tools:replace is required for the merger to accept our true
      here instead of failing or taking DJI's false.
    -->
    <application
        android:name=".DroneBuddyApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <!--
          The Mini 3's RC connects to this phone/tablet over USB. Launching
          on accessory-attach is the standard DJI sample pattern - confirm
          this still matches the 5.18.0 sample before relying on it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>

        <!--
          Injected at build time from local.properties (DJI_API_KEY) via
          manifestPlaceholders in build.gradle.kts - never hardcode a real
          key here, it must stay out of git. Requires an app key issued for
          this exact applicationId (com.dronebuddy.bridge) from
          developer.dji.com.
        -->
        <meta-data
            android:name="com.dji.sdk.API_KEY"
            android:value="${djiApiKey}" />

    </application>

</manifest>
